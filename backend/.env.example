# ============================================================
#  .env — Variables d'environnement lexpert
#  Copiez ce fichier en .env (cp .env.example .env) et remplissez les valeurs.
#  NE JAMAIS committer le fichier .env dans Git.
# ============================================================

# ── APPLICATION ─────────────────────────────────────────────
# NODE_ENV : "development" en local, "production" sur le VPS
NODE_ENV=production
PORT=3000
APP_NAME=lexpert

# URL publique (utilisée pour CORS). Plusieurs valeurs séparées par des virgules.
# Local  : http://localhost:3000
# Prod   : https://aqwarel.com,https://www.aqwarel.com
APP_URL=https://aqwarel.com,https://www.aqwarel.com

# Secrets — GENERER avec : openssl rand -hex 32
APP_SECRET=__REMPLACER_PAR_openssl_rand_hex_32__
JWT_SECRET=__REMPLACER_PAR_openssl_rand_hex_32__
JWT_EXPIRES_IN=8h

# ── BASE DE DONNEES MySQL ───────────────────────────────────
# Local Laragon : DB_USER=root / DB_PASSWORD vide
# VPS Hostinger : créer un user MySQL dédié (voir DEPLOY.md)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lexpert_db
DB_USER=lexpert
DB_PASSWORD=__REMPLACER_PAR_MOT_DE_PASSE_FORT__

# ── EMAIL SMTP (optionnel — laisser vide si pas d'envoi de mail) ────
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USER=noreply@aqwarel.com
MAIL_PASSWORD=
MAIL_FROM_NAME=lexpert
